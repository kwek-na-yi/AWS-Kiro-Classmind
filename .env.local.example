# ClassMind local configuration.
#
# Copy to .env.local (git-ignored) and fill in. Every value is server-only —
# none may be prefixed NEXT_PUBLIC_.
#
# Credentials are NOT set here. The AWS SDK resolves them from the standard
# provider chain: run `aws configure` (or export AWS_PROFILE) locally, and the
# hosting role supplies them in deployment. Never check in an access key.

# Region holding the DynamoDB table and the S3 bucket. Keep them in one region.
AWS_REGION=us-east-1

# The single DynamoDB table (partition key PK, sort key SK, on-demand, no GSI).
CLASSMIND_TABLE=classmind

# The single S3 bucket holding Lecture_Material bytes.
CLASSMIND_BUCKET=classmind-<accountId>-<region>

# The browser origin allowed to issue the presigned PUT upload. One origin only.
APP_ORIGIN=http://localhost:3000

# Generation provider configuration is deliberately absent.
#
# Amazon Bedrock is denied in the current AWS account (bedrock:InvokeModel,
# bedrock:ListFoundationModels and bedrock:ListInferenceProfiles are blocked),
# so no model id is configured and no generation client exists yet. The provider
# is chosen before the AI layer is built; its variables land here at that point.
