# ClassMind — real AWS configuration.
#
# Copy to .env.aws (git-ignored) and fill in, then:
#
#   npm run setup:aws     create the DynamoDB table and the S3 bucket
#   npm run seed:aws      upload the lecture to S3 and seed CM2026
#   npm run dev:aws       run the app against AWS
#   npm run verify:aws    drive the whole journey against AWS
#
# Nothing here contains an account id. The bucket name is yours to choose and
# must be globally unique — putting your account id in it is conventional but
# it is a value you supply, never one the code derives.

# The switch. `aws` uses real DynamoDB and S3; `local` uses DynamoDB Local.
CLASSMIND_TARGET=aws

# Region holding both the table and the bucket. Keep them in the same one.
AWS_REGION=us-east-1

# The single DynamoDB table (PK/SK, on-demand, no GSI).
CLASSMIND_TABLE=classmind

# The S3 bucket for Lecture_Material bytes. Must be globally unique.
# Convention: classmind-<something-unique>
CLASSMIND_BUCKET=classmind-CHANGE-ME

# The browser origin. Used for CORS scoping on the upload path.
APP_ORIGIN=http://localhost:3000

# --- Credentials ------------------------------------------------------------
#
# AWS Academy issues short-lived session credentials that expire every few
# hours. Paste the current set from the Learner Lab's "AWS Details" panel.
# All three are required — the session token is not optional for Academy.
#
# Alternatively leave these unset and put the same values in ~/.aws/credentials;
# the SDK reads either.

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_SESSION_TOKEN=

# DYNAMODB_ENDPOINT is deliberately absent. Setting it would route DynamoDB
# back to localhost and silently defeat the whole point of this file.
