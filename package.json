{
  "name": "classmind",
  "version": "0.1.0",
  "private": true,
  "description": "ClassMind - turns uploaded lecture material into a personalised study experience with an anonymous Class Understanding Map.",
  "homepage": "https://classmind-app.vercel.app",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kwek-na-yi/AWS-Kiro-Classmind.git"
  },
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest --run",
    "test:e2e": "playwright test",
    "seed": "tsx --conditions=react-server --env-file-if-exists=.env.local scripts/seed-demo.ts",
    "demo:reset": "tsx --conditions=react-server --env-file-if-exists=.env.local scripts/demo-reset.ts",
    "reset:class": "tsx --conditions=react-server --env-file-if-exists=.env.local scripts/reset-class.ts",
    "verify": "tsx --conditions=react-server --env-file-if-exists=.env.local scripts/verify-demo.ts",
    "setup:table": "tsx --conditions=react-server --env-file-if-exists=.env.local scripts/setup-table.ts",
    "setup:aws": "tsx --conditions=react-server --env-file=.env.aws scripts/setup-aws.ts",
    "seed:aws": "tsx --conditions=react-server --env-file=.env.aws scripts/seed-demo.ts",
    "verify:aws": "tsx --conditions=react-server --env-file=.env.aws scripts/verify-demo.ts",
    "reset:class:aws": "tsx --conditions=react-server --env-file=.env.aws scripts/reset-class.ts",
    "demo:reset:aws": "tsx --conditions=react-server --env-file=.env.aws scripts/demo-reset.ts",
    "dev:aws": "node scripts/run-with-env.mjs .env.aws npx next dev",
    "start:aws": "node scripts/run-with-env.mjs .env.aws npx next start"
  },
  "dependencies": {
    "@aws-sdk/client-dynamodb": "^3.1111.0",
    "@aws-sdk/client-s3": "^3.1111.0",
    "@aws-sdk/lib-dynamodb": "^3.1111.0",
    "next": "16.4.3",
    "pg": "8.23.1",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "server-only": "^0.0.1",
    "unpdf": "^1.8.1"
  },
  "devDependencies": {
    "@electric-sql/pglite": "0.5.8",
    "@playwright/test": "1.63.0",
    "@types/node": "24.13.3",
    "@types/pg": "8.23.1",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.4",
    "eslint": "9.39.5",
    "eslint-config-next": "16.4.3",
    "fast-check": "^4.9.0",
    "tsx": "^4.23.12",
    "typescript": "5.9.3",
    "vitest": "^4.1.10"
  }
}
